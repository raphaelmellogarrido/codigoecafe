# Variáveis de ambiente usadas neste projeto.
# Copia para .env (frontend) e configura as equivalentes no painel do serviço
# que hospedar a API (ex.: Render) — nunca commites os valores reais.

# --- Frontend (Vite) ---
# URL da API publicada. Em desenvolvimento local podes deixar vazio
# (o Vite faz proxy de /api para http://localhost:4000 — ver vite.config.js).
VITE_API_URL=

# --- Backend (server/) ---
# Chave usada para assinar os tokens JWT. Em produção, define uma string
# longa e aleatória diferente da usada em desenvolvimento.
JWT_SECRET=

# --- Achadinhos: Firebase (frontend) ---
# Valores do painel do Firebase (Project settings > General > Your apps).
# Não são segredos — ficam visíveis no JS do browser de qualquer forma.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Achadinhos: Cloudflare R2 (backend apenas) ---
# NUNCA prefixar estas com VITE_ — o Access Key/Secret ficariam expostos no
# bundle do browser. Só o server/ (upload de fotos) lê estas variáveis.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=achadinhos-fotos
R2_PUBLIC_URL_BASE=
